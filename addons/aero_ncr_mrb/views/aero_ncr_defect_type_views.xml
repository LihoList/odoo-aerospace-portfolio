<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aero_ncr_defect_type_tree" model="ir.ui.view">
        <field name="name">aero.ncr.defect.type.tree</field>
        <field name="model">aero.ncr.defect.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_aero_ncr_defect_type" model="ir.actions.act_window">
        <field name="name">Defect types</field>
        <field name="res_model">aero.ncr.defect.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
