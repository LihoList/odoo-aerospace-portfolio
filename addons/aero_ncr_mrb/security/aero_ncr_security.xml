<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aero_quality" model="ir.module.category">
        <field name="name">Aerospace Quality</field>
        <field name="description">Nonconformance and Material Review Board roles</field>
        <field name="sequence">60</field>
    </record>

    <!-- 19: groups hang off a res.groups.privilege, which carries the module category -->
    <record id="res_groups_privilege_aero_quality" model="res.groups.privilege">
        <field name="name">Aerospace Quality</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_aero_quality"/>
    </record>

    <record id="group_aero_ncr_user" model="res.groups">
        <field name="name">NCR User</field>
        <field name="privilege_id" ref="res_groups_privilege_aero_quality"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Raises nonconformances and submits them (material goes to quarantine).</field>
    </record>

    <record id="group_aero_engineering" model="res.groups">
        <field name="name">Engineering Authority</field>
        <field name="privilege_id" ref="res_groups_privilege_aero_quality"/>
        <field name="implied_ids" eval="[(4, ref('group_aero_ncr_user'))]"/>
        <field name="comment">Approves use-as-is and repair dispositions (design authority, AS9100 8.7).</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <record id="group_aero_quality_manager" model="res.groups">
        <field name="name">Quality Manager (MRB)</field>
        <field name="privilege_id" ref="res_groups_privilege_aero_quality"/>
        <field name="implied_ids" eval="[(4, ref('group_aero_ncr_user'))]"/>
        <field name="comment">Chairs the MRB: records dispositions, triggers stock actions, closes NCRs.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <record id="rule_aero_ncr_company" model="ir.rule">
        <field name="name">NCR: multi-company</field>
        <field name="model_id" ref="model_aero_ncr"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
